NC_RELEVEL_2027 <- 1631730000   # preliminary TY2027 NC; set NULL to start from certified 2026
if (!is.null(NC_RELEVEL_2027)) {
  is27 <- new_construction_forecast[["tax_year"]] == "2027"
  k_nc <- NC_RELEVEL_2027 / new_construction_forecast[["baseline"]][is27]
  yrs  <- new_construction_forecast[["tax_year"]] >= "2027"
  for (cn in c("baseline", "optimistic", "pessimistic"))
    new_construction_forecast[[cn]][yrs] <- new_construction_forecast[[cn]][yrs] * k_nc
  message("NC restarted from preliminary TY2027: scale factor ", round(k_nc, 4))
}
