p  <- unname(coef(fit)[2])
lr <- unname(coef(fit)[1]) / (1 - p)
last_rel <- fc |> filter(variable == "nc_seattle") |> slice_max(release_date, n = 1, with_ties = FALSE) |> pull(vintage)
start_yr <- 2027

fc |>
  filter(vintage == last_rel, variable %in% c("nc_seattle", "construction_sales_lagged"), year >= start_yr) |>
  select(year, variable, value) |>
  pivot_wider(names_from = variable, values_from = value) |>
  arrange(year) |>
  mutate(ratio_now = nc_seattle / construction_sales_lagged,
         ratio_ar1 = lr + p^(year - start_yr) * (first(ratio_now) - lr),
         nc_ar1    = ratio_ar1 * construction_sales_lagged,
         diff_B    = (nc_ar1 - nc_seattle) / 1e9)
