# ---- TY2027 relevel: path for TY2028-2031 ----
# "restart": grow from the TY2027 preliminary (the numbers sent to CBO on 10/12)
# "glide":   start at the TY2027 preliminary, back on trend by TY2031
# "history": TY2027 at the preliminary, trend from TY2028 on
NC_PATH         <- "glide"
NC_RELEVEL_2027 <- 1631730000
NC_GLIDE_W      <- c("2028" = 0.25, "2029" = 0.50, "2030" = 0.75, "2031" = 1.00)

if (!is.null(NC_RELEVEL_2027)) {
  tx <- as.character(new_construction_forecast[["tax_year"]])
  stopifnot(sum(tx == "2027") == 1)
  k_nc <- NC_RELEVEL_2027 / new_construction_forecast[["baseline"]][tx == "2027"]
  w <- switch(NC_PATH,
    restart = rep(0, length(tx)),
    glide   = { g <- unname(NC_GLIDE_W[tx]); g[is.na(g)] <- 0; g },
    history = ifelse(tx >= "2028", 1, 0),
    stop("NC_PATH must be restart, glide or history"))
  yrs <- tx >= "2027"
  for (cn in c("baseline", "optimistic", "pessimistic")) {
    trend <- new_construction_forecast[[cn]]
    low   <- trend * k_nc
    new_construction_forecast[[cn]][yrs] <- (low + (trend - low) * w)[yrs]
  }
  cat("NC path:", NC_PATH, "| k_nc =", round(k_nc, 4), "\n")
  print(new_construction_forecast[yrs, c("tax_year", "baseline", "optimistic", "pessimistic")])
}
