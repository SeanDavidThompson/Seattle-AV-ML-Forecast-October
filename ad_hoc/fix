map_dfr(1:4, function(h) {
  ratio_act |>
    arrange(year) |>
    mutate(last_value = lag(ratio, h),
           avg_3yr    = (lag(ratio, h) + lag(ratio, h + 1) + lag(ratio, h + 2)) / 3,
           long_avg   = lag(cummean(ratio), h)) |>
    filter(year >= 2012) |>
    summarise(h = h, n = sum(!is.na(avg_3yr)),
              across(c(last_value, avg_3yr, long_avg), ~ mean(abs(.x / ratio - 1), na.rm = TRUE)))
})
